<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical">
    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?android:attr/homeAsUpIndicator"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/button_back"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="10dp" />

    <LinearLayout
        android:id="@+id/source_language_layout"
        android:layout_below="@id/button_back"
        android:gravity="center_vertical"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">
        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:paddingEnd="10dp"
            android:text="Source Locale"
            android:textSize="20sp" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_width="0dp">
            <AutoCompleteTextView
                android:id="@+id/source_language_spinner"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:inputType="none"
                android:paddingVertical="20dp"
                android:textSize="20sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/target_language_layout"
        android:gravity="center_vertical"
        android:layout_below="@id/source_language_layout"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">
        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:paddingEnd="10dp"
            android:text="Target Locale"
            android:textSize="20sp" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_width="0dp">
            <AutoCompleteTextView
                android:id="@+id/target_language_spinner"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:inputType="none"
                android:paddingVertical="20dp"
                android:textSize="20sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <ScrollView
        android:layout_above="@id/download_button"
        android:layout_below="@id/target_language_layout"
        android:layout_height="match_parent"
        android:layout_width="match_parent">
        <TextView
            android:id="@+id/text_view"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:padding="20dp"
            android:textSize="24sp" />
    </ScrollView>
    <Button
        android:id="@+id/download_button"
        android:layout_above="@+id/mic_button"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:padding="20dp"
        android:text="Download" />
    <Button
        android:id="@+id/mic_button"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:padding="20dp"
        android:text="Start Recording" />
</RelativeLayout>
